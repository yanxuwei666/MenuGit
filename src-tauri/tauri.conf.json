{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MenuGit",
  "version": "0.1.0",
  "identifier": "dev.menugit.desktop",
  "bundle": {
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "files": {
        "PlugIns/MenuGitFinderSync.appex": "../extensions/macos/build/MenuGitFinderSync.appex"
      }
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/before-tauri-build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MenuGit",
        "width": 980,
        "height": 660,
        "minWidth": 780,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  }
}
