{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MenuGit",
  "version": "0.1.0",
  "identifier": "dev.menugit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MenuGit",
        "width": 980,
        "height": 660,
        "minWidth": 780,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  }
}
